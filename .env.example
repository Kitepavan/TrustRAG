# Generation provider: any OpenAI-compatible chat-completions API.
# Code defaults target OpenRouter; local operation uses Z.ai —
# https://api.z.ai/api/paas/v4 with model glm-5-turbo. Create a key at
# https://z.ai (API keys) and paste it below. A missing key does not prevent
# startup; no eligible context skips generation.
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_API_KEY=

# Model id for the configured provider (code default: openrouter/auto).
LLM_MODEL=glm-5-turbo
# Substituted only when the primary model is refused with HTTP 402 (billing).
# Z.ai refusals are account-level, not model-level; pin to the primary to disable.
# LLM_FALLBACK_MODEL=glm-5-turbo

# OpenRouter API key: the historical default provider. LLM_API_KEY takes precedence
# for the configured provider; this key is only ever sent to openrouter.ai, and it
# remains the bearer fallback for the default decision endpoint below.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# System One decision endpoint used for prompt-injection screening.
# Optional; defaults to OpenRouter Mercury Decide. A locally served Laya classifier
# answers the same contract and needs no key.
# Switching the classifier requires recalibrating INJECTION_THRESHOLD (see README).
# TRUSTRAG_DECISION_URL=http://127.0.0.1:8077/v1/systemone
# TRUSTRAG_DECISION_MODEL=english
# Optional bearer for that endpoint; falls back to OPENROUTER_API_KEY.
# TRUSTRAG_DECISION_API_KEY=

# Local path to the EmbeddingGemma-300M model (optional; defaults to ~/AI-Models)
# EMBEDDING_MODEL_PATH=/home/pavan/AI-Models/embeddinggemma-300m

# JWT signing secret for access tokens (required to log in) — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TRUSTRAG_JWT_SECRET=

# Comma-separated origins allowed by CORS (optional; defaults to the Vite dev/build ports)
# TRUSTRAG_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Fixed demo passwords are disabled by default. Local demonstrations only:
# TRUSTRAG_DEMO_MODE=true
# Otherwise configure per-account scrypt hashes (salt_hex:hash_hex), which take precedence:
# TRUSTRAG_PASSWORD_HASH_EMP_USER=
# TRUSTRAG_PASSWORD_HASH_HR_USER=
# TRUSTRAG_PASSWORD_HASH_SEC_ADMIN=
# TRUSTRAG_PASSWORD_HASH_ADMIN=

# Frontend API base URL: put this in frontend/.env.local, not backend .env.
# Optional, default http://localhost:8000. VITE_ settings are public browser values.
# VITE_API_URL=http://localhost:8000

# Zai API key (required) — https://platform.z.ai
ZAI_API_KEY=

# Zai LLM model id (optional, default glm-4.7-flash)
# ZAI_LLM_MODEL=glm-4.7-flash

# Local path to the EmbeddingGemma-300M model (optional; defaults to ~/AI-Models)
# EMBEDDING_MODEL_PATH=/home/pavan/AI-Models/embeddinggemma-300m

# JWT signing secret for access tokens (required to log in) — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TRUSTRAG_JWT_SECRET=

# Comma-separated origins allowed by CORS (optional; defaults to the Vite dev/build ports)
# TRUSTRAG_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Frontend: backend API base URL (optional, default http://localhost:8000)
# VITE_API_URL=http://localhost:8000
